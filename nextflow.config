params {
    input   = "${projectDir}/input/samplesheet.csv"
    outdir  = "${projectDir}/results"
    ref_dir = "${projectDir}/references"
}

process {
    cpus   = 2
    memory = '4 GB'

    withLabel: process_single {
        cpus   = 1
        memory = '2 GB'
    }
    withLabel: process_medium {
        cpus   = 2
        memory = '4 GB'
    }
    withLabel: process_high {
        cpus   = 4
        memory = '8 GB'
    }
}

